{
  "name": "@cartao-diario/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "nx serve web",
    "build": "nx build web",
    "build:pages": "nx build web --base-href ${BASE_HREF:-/cartao-diario/} && cp dist/apps/web/browser/index.html dist/apps/web/browser/404.html",
    "preview": "nx build web && node tools/servidor-estatico.mjs dist/apps/web/browser 4300",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint typecheck",
    "e2e": "nx e2e web-e2e",
    "e2e:pages": "pnpm build:pages && E2E_BASE=${BASE_HREF:-/cartao-diario/} E2E_PAGES=1 nx e2e web-e2e --exclude-task-dependencies",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@angular/service-worker": "~22.1.8",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "dexie": "^4.4.6",
    "pdfmake": "^0.3.12",
    "rxjs": "~7.8.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22",
    "@types/pdfmake": "^0.3.3",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
