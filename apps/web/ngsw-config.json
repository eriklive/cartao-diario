{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/media/*.woff2",
          "/icons/*"
        ]
      }
    },
    {
      "name": "fontes-reserva",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/*.woff"]
      }
    }
  ]
}
